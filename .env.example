# Optional. Only needed for the POESESSID stash adapter (src/stash/official_api.py).
# Copy this file to .env and paste the value of your pathofexile.com POESESSID cookie.
# This is a session credential for YOUR account -- never commit .env or share this value.
POESESSID=

# Your PoE account name, including the discriminator, e.g. Exile#1234
POE_ACCOUNT_NAME=

# Contact address embedded in the User-Agent sent to GGG. GGG asks that automated
# clients identify themselves. Use a real address you monitor.
POE_CONTACT_EMAIL=

# Optional. Only used by src/auth/poe_oauth.py, which requires a client registered
# with GGG. Leave blank if you do not have one.
POE_OAUTH_CLIENT_ID=
POE_OAUTH_CLIENT_SECRET=
