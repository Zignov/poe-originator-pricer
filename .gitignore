.venv/
__pycache__/
*.pyc
.env
data/*.db
data/*.db-journal
models/*.pkl
models/*.json
!models/.gitkeep
# ...except the three artifacts a release ships, which are tracked on purpose.
# Together they are 1.3 MB -- small enough that git does not care, and they are
# the difference between a clone or a download that prices a map immediately
# and one that first wants a 20-minute market collection. Retraining rewrites
# them, so expect them in a diff; that is a real change to what ships, not
# noise. Every OTHER model in this directory stays ignored.
!models/originator_model.pkl
!models/originator_model.json
!models/affix_catalogue.json
.pytest_cache/
.playwright-mcp/
data/*.log
data/collect*.log
*.png
data/*.db-shm
data/*.db-wal
# Bucket cache for the market-comparison mode. Short-lived fetched market state;
# safe to delete at any time and never worth sharing.
data/market_comparison_cache.json
.ruff_cache/

# Local config -- copy config.example.yaml to config.yaml and edit.
# Kept out of the repo because it carries your own contact address.
config.yaml
catboost_info/

# Agent worktrees. Transient, and each one is a full checkout.
.claude/worktrees/

# Release zips built by scripts/package_release.py.
dist/
